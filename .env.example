# このファイルをコピーして .env を作る:  cp .env.example .env
# .env は git に入れない。本番ではサーバーの環境変数で同じキーを渡す。
# ここにある値は開発用のダミー値です。DJANGO_SECRET_KEY は cp 後に必ず生成した値へ置き換える:
#   sed -i '' "s|^DJANGO_SECRET_KEY=.*|DJANGO_SECRET_KEY=$(python3 -c 'import secrets; print(secrets.token_urlsafe(50))')|" .env

# --- Django ---
DJANGO_SECRET_KEY=REPLACE_ME_generate_a_real_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- PostgreSQL ---
# POSTGRES_* は db コンテナの初期化に使う。DATABASE_URL は web からの接続先。
POSTGRES_DB=ssw
POSTGRES_USER=ssw
POSTGRES_PASSWORD=dev-only-change-me
DATABASE_URL=postgres://ssw:dev-only-change-me@db:5432/ssw

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- メール（開発は Mailpit。本番は自社 SMTP） ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@example.invalid

# --- ファイル保存（Attachment・ロゴ） ---
# 本番（S3 互換）の例:
#   DJANGO_STORAGE_BACKEND=storages.backends.s3.S3Storage
#   DJANGO_STORAGE_OPTIONS={"bucket_name": "...", "endpoint_url": "https://...", "region_name": "ap-northeast-1"}
#   認証情報は AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY で渡す（OPTIONS には書かない）
DJANGO_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
DJANGO_STORAGE_OPTIONS={"location": "/app/media"}

# --- 認証（第8章）。未設定時もこの既定値で動く ---
AUTH_LOCKOUT_FAILURE_LIMIT=5
AUTH_LOCKOUT_MINUTES=30
SESSION_IDLE_TIMEOUT_MINUTES=30

# --- 接続元 IP（監査ログ・ログイン失敗ロック） ---
# true にすると CF-Connecting-IP ヘッダーを接続元とみなす。Cloudflare Tunnel 経由でしか
# 届かない構成（サーバーのポートを開けていない）でだけ true にする。それ以外ではヘッダーを偽装できる。
TRUST_CF_CONNECTING_IP=false
