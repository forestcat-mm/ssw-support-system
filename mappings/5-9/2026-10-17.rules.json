{
  "form_id": "5-9",
  "valid_from": "2026-10-17",
  "note": "T30 の見本の規則（ADR-0019）。記録が無い人には「記録がありません」の 1 件だけを出す（requires）。確認書の署名済みの添付は生成の後に付けるので、unsigned は出さない。すべての欄の規則は T32 で足す。",
  "rules": [
    {"id": "briefing_record", "type": "check", "name": "briefing_record_exists", "params": {"kind": "pre_guidance"}, "severity": "block"},
    {"id": "briefing_warnings", "type": "check", "name": "briefing_warnings", "params": {"exclude": ["unsigned"]}, "severity": "warn", "requires": "briefing_record"},
    {"id": "organization_name_required", "type": "required", "key": "organization.name", "label": "特定技能所属機関（又は登録支援機関）の氏名又は名称", "severity": "block", "fix": {"object": "organization", "url": "settings:organization_edit"}},
    {"id": "explainer_required", "type": "required", "key": "staff.name", "label": "説明者の氏名", "severity": "block", "fix": {"object": "worker", "url": "workers:edit"}},
    {"id": "session_date_required", "type": "required", "key": "session1.date", "label": "実施日時", "severity": "block", "requires": "briefing_record", "fix": {"object": "briefing", "url": "workers:support_briefing"}}
  ]
}
