msgstr "Ⅲ４: 自機関の電話番号が空です。"

msgid "when it is secured"
msgstr "確保の時点"

msgid "room area"
msgstr "居室の広さ"

msgid "whether rent is collected"
msgstr "居住費の徴収の有無"

msgid "monthly rent"
msgstr "居住費の額"

msgid "owned or leased"
