msgid "The site of the contract is in another field (%(field)s)."
msgstr "契約の事業所はほかの分野（%(field)s）です。"

#, python-format
msgid ""
"These operation categories are not the duties pledged in the form: %(names)s"
msgstr "次の業務区分は、誓約書の業務ではありません: %(names)s"

#, python-format
msgid ""
"The industry code of %(site)s (%(code)s) is not in the industries pledged in"
" the form."
msgstr "%(site)s の産業分類（%(code)s）は、誓約書の産業にありません。"

#, python-format
msgid ""
"The industry of %(site)s (%(code)s) is pledged only with a limitation: "
"%(item)s. Check that the site meets it."
msgstr "%(site)s の産業（%(code)s）は限定つきの産業です: %(item)s。事業所が当てはまるかを確かめてください。"

