msgid "The termination of the support contract was cancelled: %(reason)s"
msgstr "支援委託契約の終了が取り消されました: %(reason)s"

msgid "Enter the monthly fee of the contract first."
msgstr "先に契約の月額を入れてください。"

#, python-format
msgid "The form has %(limit)d rows. Combine the items."
msgstr "様式の行は %(limit)d 行です。項目をまとめてください。"

#, python-format
msgid ""
"The total of the items (%(total)s yen) differs from the monthly fee (%(fee)s"
" yen)."
msgstr "内訳の合計（%(total)s 円）が月額（%(fee)s 円）と違います。"

msgid "Enter at least one item."
msgstr "項目を 1 つ以上入れてください。"

#, python-format
msgid ""
"These operation categories do not belong to the site's field: %(names)s"
msgstr "事業所の分野に属さない業務区分です: %(names)s"

msgid ""
"The field cannot be changed because employment contracts use this site as "
