# 通しのテスト（Playwright）用。make e2e で使う。開発・本番のイメージにはブラウザを入れない。
# ブラウザの版は playwright（pyproject の e2e グループ）と同じ版のイメージに合わせる。
FROM mcr.microsoft.com/playwright/python:v1.63.0-noble

COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /usr/local/bin/uv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    DJANGO_ALLOW_ASYNC_UNSAFE=true \
    PATH="/opt/venv/bin:$PATH"

# 帳票の生成を e2e で通すため、web と同じ LibreOffice（GUI なし）とフォントを入れる（T31、ADR-0018）
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gettext \
        libreoffice-writer-nogui libreoffice-calc-nogui \
        fontconfig fonts-ipafont-mincho fonts-ipafont-gothic fonts-noto-cjk \
        fonts-crosextra-carlito \
    && rm -rf /var/lib/apt/lists/*
COPY backend/config/fonts/99-form-fonts.conf /etc/fonts/conf.d/99-form-fonts.conf
RUN fc-cache -f

WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-cache --group e2e
