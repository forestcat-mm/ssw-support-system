      "kinds": {
        "pre_guidance": {
          "form": "参考様式第5-9号",
          "duration": {"guideline_minutes": 180, "guideline_kind": "about", "minimum_minutes": 60},
          "sections": [
            {
              "code": "1.a",
              "form_number": 1,
              "pages": "別冊 9〜11頁",
              "items": [
                {"code": "1.a.1", "label": "従事させる業務の内容、報酬の額その他の労働条件（雇用条件書に記載された事項。労働基準法第15条に基づいて説明する）"},
                {"code": "1.a.2", "label": "危険又は有害な業務に従事すると見込まれる場合は、その業務の内容と安全衛生に関する事項"}
              ]
            },
            {
              "code": "1.b",
              "form_number": 2,
              "pages": "別冊 9頁",
              "items": [
                {"code": "1.b.1", "label": "本邦において行うことができる活動の内容（特定技能1号の活動であること、技能水準が認められた業務区分に従事すること）"}
              ]
            },
            {
              "code": "1.c",
              "form_number": 3,
              "pages": "別冊 9頁",
              "items": [
                {"code": "1.c.1", "label": "新たに入国する場合：在留資格認定証明書の送付を受け、受領後に日本大使館・領事館で査証を申請し、交付日から3か月以内に入国すること"},
                {"code": "1.c.2", "label": "既に在留している場合：在留資格変更許可申請を行い、許可を受ける（在留カードを受領する）までは、新たな就労先で就労できないこと"}
              ]
            },
            {
              "code": "1.d",
              "form_number": 4,
              "pages": "別冊 9頁",
              "items": [
                {"code": "1.d.1", "label": "保証金の徴収・財産の管理や、違約金を定める契約等をしておらず、締結させないことが見込まれること（現にしていないこと及び将来にわたりしないことを確認する）"}
              ]
            },
            {
              "code": "1.e",
              "form_number": 5,
              "pages": "別冊 9頁",
              "items": [
                {"code": "1.e.1", "label": "外国の機関に費用を支払っている場合は、その額及び内訳を十分理解して合意している必要があること（支払費用の有無、機関の名称、支払年月日、金額及び内訳を確認する）"}
              ]
            },
            {
              "code": "1.f",
              "form_number": 6,
              "pages": "別冊 9頁",
              "items": [
                {"code": "1.f.1", "label": "支援に要する費用を、直接又は間接に本人に負担させないこと（義務的支援の費用は特定技能所属機関等が負担する）"}
              ]
            },
            {
              "code": "1.g",
              "form_number": 7,
              "pages": "別冊 9〜10頁",
              "items": [
                {"code": "1.g.1", "label": "入国しようとする港又は飛行場で出迎え、特定技能所属機関の事業所（又は住居）まで送迎すること"}
              ]
            },
            {
              "code": "1.h",
              "form_number": 8,
              "pages": "別冊 10頁",
              "items": [
                {"code": "1.h.1", "label": "適切な住居の確保に係る支援の内容（社宅等を貸与する予定の場合は、広さと、家賃等本人が負担する金額を含む）"}
              ]
            },
            {
              "code": "1.i",
              "form_number": 9,
              "pages": "別冊 10頁",
              "items": [
                {"code": "1.i.1", "label": "職業生活・日常生活・社会生活に関する相談又は苦情の申出を受ける体制（受け付ける曜日・時間・方法など）"}
              ]
            },
            {
              "code": "1.j",
              "form_number": null,
              "pages": "別冊 10頁",
              "items": [
                {"code": "1.j.1", "label": "特定技能所属機関等の支援担当者の氏名と連絡先（メールアドレス等）"}
              ]
            }
          ]
        },
        "orientation": {
          "form": "参考様式第5-8号",
          "duration": {"guideline_minutes": 480, "guideline_kind": "at_least", "minimum_minutes": 240},
          "sections": [
            {
              "code": "4.a",
              "form_number": 1,
              "pages": "別冊 20〜21頁",
              "items": [
                {"code": "4.a.1", "label": "金融機関の利用方法（入出金・振込等の方法、利用できる時間、ATM の使い方、手数料、出国するときの口座の閉鎖）"},
                {"code": "4.a.2", "label": "医療機関の利用方法等（症状別の医療機関、受診の方法、保険証の持参、アレルギー・宗教上の理由で治療に制限がある場合の説明）"},
                {"code": "4.a.3", "label": "交通ルール等（歩行者は右側・車両は左側通行と歩行者優先、自転車損害賠償責任保険、自動車・バイクの運転免許）"},
                {"code": "4.a.4", "label": "交通機関の利用方法等（地域の公共交通機関、勤務先までの経路と所要時間、通勤定期・切符・IC カードの購入と利用）"},
                {"code": "4.a.5", "label": "生活ルール・マナー（ゴミの分別・出し方・収集日・粗大ゴミ、騒音など近隣の迷惑になる行為、空き地や畑への無断の立入り、喫煙の制限）"},
                {"code": "4.a.6", "label": "生活必需品等の購入方法等（スーパーマーケット、コンビニエンスストア、ドラッグストア、家電量販店等の所在地）"},
                {"code": "4.a.7", "label": "気象情報や、災害時に行政等が提供する災害情報の入手方法等（ホームページ、アプリ、外国人向けのコミュニティサイト等）"},
                {"code": "4.a.8", "label": "我が国で違法となる行為の例（銃砲刀剣類・違法薬物の所持、在留カードの不携帯、在留カード・保険証の貸し借り、口座・携帯電話の譲渡、他人の自転車の使用等）"},
                {"code": "4.a.9", "label": "出産・子育てに関する制度（母子健康手帳の交付、産前産後休業、育児休業等）"}
              ]
            },
            {
              "code": "4.b",
              "form_number": 2,
              "pages": "別冊 21〜22頁",
              "items": [
                {"code": "4.b.1", "label": "所属機関等に関する届出（入管法第19条の16。所属機関の名称・所在地の変更や消滅、契約の終了・新たな締結）"},
                {"code": "4.b.2", "label": "住居地に関する届出（入管法第19条の7から第19条の9まで。上陸後・在留資格の変更等に伴う届出、住居地の変更の届出）"},
                {"code": "4.b.3", "label": "社会保障に関する手続（健康保険・厚生年金保険、又は国民健康保険・国民年金。未納があると在留諸申請が不許可になる場合があること）"},
                {"code": "4.b.4", "label": "税に関する手続（源泉徴収・特別徴収、住民税の納付の仕組み。未納があると在留諸申請が不許可になる場合があること）"},
                {"code": "4.b.5", "label": "個人番号（マイナンバー）制度の仕組み（通知カードとマイナンバーカード、使えるサービス）"},
                {"code": "4.b.6", "label": "その他の行政手続（自転車の防犯登録、妊娠が分かった場合の母子健康手帳の交付手続等）"}
              ]
            },
            {
              "code": "4.c",
              "form_number": 3,
              "pages": "別冊 23頁",
              "items": [
                {"code": "4.c.1", "label": "相談又は苦情の申出に対応する者（支援担当者）の氏名と、電話番号・メールアドレス等"},
                {"code": "4.c.2", "label": "相談又は苦情を申し出ることができる国・地方公共団体の機関の連絡先（地方出入国在留管理局、労働基準監督署、ハローワーク、法務局、警察署、市区町村、弁護士会・法テラス、大使館・領事館等）"}
              ]
            },
            {
              "code": "4.d",
              "form_number": 4,
              "pages": "別冊 24頁",
              "items": [
                {"code": "4.d.1", "label": "外国人患者の受入れ体制が整った病院（通訳人の配置・医療通訳サービスの導入等）の名称、所在地及び連絡先"},
                {"code": "4.d.2", "label": "医療通訳の雇入費用等をカバーする民間医療保険への加入の案内"}
              ]
            },
            {
              "code": "4.e",
              "form_number": 5,
              "pages": "別冊 24〜25頁",
              "items": [
                {"code": "4.e.1", "label": "トラブル対応や身を守るための方策（地震・津波・台風等の自然災害や事件・事故への備え、火災の予防と消火器の使い方）"},
                {"code": "4.e.2", "label": "緊急時の連絡先・場所と通報の方法（110番・119番・118番、大使館・領事館、最寄りの警察署・交番、救急医療機関）"},
                {"code": "4.e.3", "label": "気象情報・避難指示等の把握方法と、災害時の避難場所"},
                {"code": "4.e.4", "label": "緊急速報メールの活用と、対応機種・受信の設定方法"}
              ]
            },
            {
              "code": "4.f",
              "form_number": 6,
              "pages": "別冊 25頁",
              "items": [
                {"code": "4.f.1", "label": "入管法令（在留手続、みなし再入国、在留資格の取消し、在留カードの手続等）と労働関係法令（労働契約、労働保険、休業補償、労働安全衛生、未払賃金の立替払制度）の知識"},
                {"code": "4.f.2", "label": "入管法令の違反（資格外活動、不法就労者雇用等）があった場合の相談先（地方出入国在留管理局）と連絡方法"},
                {"code": "4.f.3", "label": "労働に関する法令の違反（残業代を含む賃金の不払、36協定を超える時間外・休日労働等）があった場合の相談先（労働基準監督署又は地方出入国在留管理局）と連絡方法"},
                {"code": "4.f.4", "label": "特定技能雇用契約に反することがあった場合の相談先（地方出入国在留管理局又は労働基準監督署）と連絡方法"},
                {"code": "4.f.5", "label": "人権侵害があった場合の相談先（法務局・地方法務局又は地方出入国在留管理局）と連絡方法"},
                {"code": "4.f.6", "label": "年金の受給権（老齢年金の受給資格期間は10年、障害年金・遺族年金）と脱退一時金制度の知識、相談先（日本年金機構）と連絡方法"}
              ]
            }
          ]
        }
      }
    }
  ]
}
