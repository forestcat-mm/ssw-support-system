  "patterns": [
    {
      "pattern": "^有（更新(.*)回まで／通算契約期間(.*)年まで）$",
      "replace": "有（最多更新\\1次／总合同期限\\2年为止）"
    },
    {
      "pattern": "^■　毎月(　*)末日、　□　毎月　　　日$",
      "replace": "■　每月\\1月末、　□　每月　　　日"
    },
    {
      "pattern": "^■　毎月(　*)(\\d+)日、　□　毎月　　　日$",
      "replace": "■　每月\\1\\2日、　□　每月　　　日"
    },
    {
      "pattern": "^■　翌月末日$",
      "replace": "■　次月月末"
    },
    {
      "pattern": "^■　翌月(\\d+)日$",
      "replace": "■　次月\\1日"
    },
    {
      "pattern": "^■　翌々月末日$",
      "replace": "■　下下月月末"
    },
    {
      "pattern": "^■　翌々月(\\d+)日$",
      "replace": "■　下下月\\1日"
    },
    {
      "pattern": "^(\\d+)時$",
      "replace": "\\1点"
    },
    {
      "pattern": "^(\\d+)時(\\d+)分$",
      "replace": "\\1点\\2分"
    },
    {
      "pattern": "^(\\d+)か月$",
      "replace": "\\1个月"
    },
    {
      "pattern": "^(\\d+)年$",
      "replace": "\\1年"
    }
  ],
